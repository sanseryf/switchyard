[Unit]
Description=Switchyard webhook router
Documentation=https://github.com/sanseryf/switchyard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=switchyard
Group=switchyard
WorkingDirectory=/opt/switchyard
EnvironmentFile=/etc/switchyard/switchyard.env
ExecStart=/opt/switchyard/.venv/bin/switchyard serve --config /etc/switchyard/routes.yaml --host 127.0.0.1 --port 8080
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/switchyard /etc/switchyard

[Install]
WantedBy=multi-user.target

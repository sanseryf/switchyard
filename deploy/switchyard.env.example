# Copy to /etc/switchyard/switchyard.env, chmod 600, owned by root:switchyard.
GITHUB_WEBHOOK_SECRET=replace-with-a-long-random-value

# Optional: where the SQLite file lives (must be writable by the service user).
# The route file's `database:` wins if set.
# SWITCHYARD_DATABASE=/var/lib/switchyard/switchyard.db
